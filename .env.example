# Copy this file to .env and fill in real values before running the app.

# Postgres connection string (Supabase / Neon / local Postgres all work).
DATABASE_URL="postgresql://satapp:satapp_dev_pw@localhost:5432/satapp_dev?schema=public"

# Random secret used to derive session token hashes. Generate with:
#   openssl rand -hex 32
SESSION_SECRET="change-me-to-a-random-64-char-hex-string"

# Credentials for the first admin account, used only by `npm run seed`.
# Required — the seed script refuses to run without both of these set.
SEED_ADMIN_EMAIL="admin@12wsat.local"
SEED_ADMIN_PASSWORD="change-me-before-seeding"
# SEED_ADMIN_NAME="Mentor"

# Optional: also seed one real student account (in addition to the two
# fixed demo accounts ha@12wsat.local / minh@12wsat.local).
# SEED_STUDENT_EMAIL=""
# SEED_STUDENT_PASSWORD=""
# SEED_STUDENT_NAME=""

# AI test parsing (Admin -> upload -> AI parse). Leave unset to use the
# built-in mock parser (src/lib/ai/mockParser.ts) — the whole upload/review/
# publish flow still works end to end without a real key.
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-opus-5"
# AI_PARSE_MODE="mock"

# File storage. Default is local disk (.data/uploads) — fine for dev, not for
# production (see README "Giới hạn đã biết"). Set STORAGE_DRIVER=s3 plus the
# S3_* vars for Supabase Storage / Cloudflare R2 (both speak the S3 API).
# STORAGE_DRIVER="s3"
# S3_BUCKET="12wsat-uploads"
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
